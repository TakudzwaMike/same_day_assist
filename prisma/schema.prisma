datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   // Customer, Contractor, Dispatcher, Administrator, Super Administrator
  name         String
  phone        String
  address      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Comprehensive Onboarding & Enterprise Data
  idNumber                String?  // ID / Passport Number
  accountType             String?  // Individual, Business
  companyName             String?
  companyRegNumber        String?
  vatNumber               String?
  secondaryPhone          String?
  preferredContactMethod  String?  // Email, SMS, WhatsApp, Push
  emergencyContactName    String?
  emergencyContactPhone   String?
  industry                String?
  communicationPreferences String? // JSON preferences

  // Profile Security & 60-Day Edit Lock
  lastProfileUpdateAt     DateTime?

  // Contractor Vetting & Compliance Verification
  verificationStatus      String?  @default("Pending Review") // Pending Review, Approved, Information Requested, Rejected
  verificationNotes       String?
  verifiedAt              DateTime?
  yearsOfExperience       Int?     @default(1)
  businessLicenseUrl      String?
  taxClearanceUrl         String?
  insuranceProofUrl       String?
  policeClearanceUrl      String?
  tradeQualificationsUrl  String?
  coverageAreaJson        String?  // JSON list of suburbs / cities covered
  badgeTitles             String?  // JSON list of achievement badges
  isFeatured              Boolean  @default(false)

  // Customer specific details
  status       String?  // Prospect, Onboarding, Active, Suspended, Expired
  package      String?  // Gold, Platinum, Diamond
  memberSince  String?
  repairsCount Int      @default(0)
  totalPaid    Float    @default(0.0)

  // Contractor specific details
  rating       Float?   @default(5.0)
  specialty    String?  // Security Services, Cleaning, Plumbing, Electrical, Locksmith, Towing, Roadside, Medical, Home Assistance, Maintenance
  isAvailable  Boolean? @default(true)
  lat          Float?   @default(-26.2041) // Default JHB latitudes
  lng          Float?   @default(28.0473)  // Default JHB longitudes
  certifications String? // JSON string array of skills and certs
  workload     Int      @default(0) // Count of active jobs assigned

  // Relations
  jobsAsCustomer       Job[]                  @relation("CustomerJobs")
  jobsAsContractor     Job[]                  @relation("ContractorJobs")
  assessments          Assessment[]
  payments             Payment[]
  auditLogs            AuditLog[]
  fileRecords          FileRecord[]
  notificationSettings NotificationPreference?
  savedLocations       SavedLocation[]
  authorisedContacts   AuthorisedContact[]
  profileUpdateRequests ProfileUpdateRequest[]
  ratingsGiven         JobRating[]            @relation("CustomerRatings")
  ratingsReceived      JobRating[]            @relation("ContractorRatings")
  chatMessagesSent     ChatMessage[]          @relation("SentMessages")
  chatMessagesReceived ChatMessage[]          @relation("ReceivedMessages")
  wallet               Wallet?
  providerAwards       ProviderAward[]
}


model SavedLocation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // Home, Office, Warehouse, Factory, Branch, Construction Site
  address     String
  lat         Float
  lng         Float
  accessNotes String?
  createdAt   DateTime @default(now())
}

model AuthorisedContact {
  id          String   @id @default(uuid())
  userId      String   // Corporate account user ID
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  position    String
  permissions String   @default("Full") // Full, Dispatch Only, Billing Only
  createdAt   DateTime @default(now())
}

model ProfileUpdateRequest {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposedChanges  String    // JSON snapshot of requested profile changes
  status           String    @default("Pending") // Pending, Approved, Rejected
  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
}

model Enquiry {
  id              String       @id @default(uuid())
  customerName    String
  email           String
  phone           String
  address         String
  serviceCategory String       // Security, Cleaning, Plumbing, Electrical, Locksmith, Towing, Roadside, Medical, Home Assistance, Maintenance
  notes           String
  status          String       @default("Pending") // Pending, Scheduled, Assessed, Quoted, Approved, Completed
  createdAt       DateTime     @default(now())
  assessments     Assessment[]
  quotations      Quotation[]
}

model Assessment {
  id              String    @id @default(uuid())
  enquiryId       String
  enquiry         Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  contractorId    String
  contractor      User      @relation(fields: [contractorId], references: [id])
  scheduledAt     DateTime
  completedAt     DateTime?
  issuesFound     String    // Stored as JSON string list
  photoUrl        String?
  videoUrl        String?
  estimatedCost   Float
  status          String    @default("Scheduled") // Scheduled, Assessing, Uploaded
  contractorNotes String?
  fileRecords     FileRecord[]
}

model Quotation {
  id          String       @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry      @relation(fields: [enquiryId], references: [id])
  amount      Float
  lineItems   String       // Stored as JSON line items list
  status      String       @default("Pending") // Pending, Approved, Declined
  createdAt   DateTime     @default(now())
  approvedAt  DateTime?
  fileRecords FileRecord[]
}

model Job {
  id                      String       @id @default(uuid())
  customerId              String
  customer                User         @relation("CustomerJobs", fields: [customerId], references: [id])
  serviceType             String       // Security, Cleaning, Plumbing, Electrical, Locksmith, Towing, Roadside, Medical, Home Assistance, Maintenance
  description             String
  photoUrl                String?
  videoUrl                String?
  assignedContractorId    String?
  assignedContractor      User?        @relation("ContractorJobs", fields: [assignedContractorId], references: [id])
  status                  String       @default("Request Received") // Request Received, Request Under Review, Service Provider Assigned, Preparing for Dispatch, Dispatched, En Route, Arrived, Service In Progress, Service Completed
  trackerProgress         Int          @default(0)
  
  // Real-time tracking & vehicle details
  vehicleInfo             String?      // JSON: { make, model, licensePlate, color }
  currentLat              Float?
  currentLng              Float?
  estimatedArrivalMinutes Int?         @default(15)
  distanceRemainingKm     Float?       @default(4.2)

  // Live Photo Milestones (Before, During, After)
  photoBeforeUrl          String?
  photoDuringUrl          String?
  photoAfterUrl           String?

  rating                  Int?
  ratingComment           String?
  createdAt               DateTime     @default(now())
  assignedAt              DateTime?
  completedAt             DateTime?
  closedAt                DateTime?
  contractorNotes         String?
  contractorSignature     String?      // Base64 signature
  completionPhoto         String?
  fileRecords             FileRecord[]
  jobRatings              JobRating[]
  chatMessages            ChatMessage[]
}

model JobRating {
  id                  String   @id @default(uuid())
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId          String
  customer            User     @relation("CustomerRatings", fields: [customerId], references: [id])
  contractorId        String
  contractor          User     @relation("ContractorRatings", fields: [contractorId], references: [id])
  
  // 8-Dimensional Performance Metrics (1 to 5)
  professionalism     Int      @default(5)
  punctuality         Int      @default(5)
  responseTime        Int      @default(5)
  communication       Int      @default(5)
  qualityOfWork       Int      @default(5)
  friendliness        Int      @default(5)
  problemResolution   Int      @default(5)
  overallSatisfaction Int      @default(5)

  writtenFeedback     String?
  photoBeforeUrl      String?
  photoAfterUrl       String?
  createdAt           DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId   String
  recipient     User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  senderRole    String   // Customer, Contractor, Dispatcher, Administrator
  text          String
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float               @default(0.0)
  currency     String              @default("ZAR")
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // TopUp, Payment, Refund, Bonus Reward
  description String
  referenceId String?
  createdAt   DateTime @default(now())
}

model ProviderAward {
  id           String   @id @default(uuid())
  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  title        String   // Top Performer of the Month, Fastest Responder, 5-Star Customer Favourite, 100+ Jobs Milestone, Most Reliable
  category     String
  iconName     String   @default("Award")
  awardedAt    DateTime @default(now())
}

model Payment {
  id           String   @id @default(uuid())
  customerId   String
  customer     User     @relation(fields: [customerId], references: [id])
  customerName String
  type         String   // Onboarding Fee, Monthly Premium, Assistance Co-pay
  amount       Float
  status       String   @default("Pending") // Paid, Pending
  date         String   // yyyy-mm-dd
  createdAt    DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  userType      String   // Customer, Contractor, Dispatcher, Administrator, Super Administrator
  action        String
  result        String   @default("Success") // Success, Failed
  details       String
  ipAddress     String?
  userAgent     String?
  previousValue String?  // JSON snapshot before
  newValue      String?  // JSON snapshot after
}

model FileRecord {
  id           String      @id @default(uuid())
  filename     String
  originalName String
  fileType     String
  size         Int
  url          String
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  customerId   String?
  jobId        String?
  job          Job?        @relation(fields: [jobId], references: [id])
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  quotationId  String?
  quotation    Quotation?  @relation(fields: [quotationId], references: [id])
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     Boolean @default(true)
  sms       Boolean @default(true)
  push      Boolean @default(true)
  inApp     Boolean @default(true)
}


